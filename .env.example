# ═══════════════════════════════════════════════════════════════
# ThabangVision Labs — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit real keys to this file
# ═══════════════════════════════════════════════════════════════

# ─── Set in Vercel dashboard, NOT here ───
# VERCEL_OIDC_TOKEN — add via Vercel UI, never commit to repo

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google's own sign-in button (Google names this site, not supabase.co). The web
# client ID from Supabase > Auth > Providers > Google. Set it only where this
# site's address is in that client's "Authorised JavaScript origins" (Google
# takes no wildcards, so not on Vercel previews). Unset = the redirect button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI Providers ───
# Active provider: "anthropic", "gemini", or "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
# Read by @ai-sdk/google for model routing (same key as GEMINI_API_KEY)
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=

# ─── AI Gateway (optional) ───
# One rule: ANY configured provider takes over when the preferred one fails
# (out of credit, bad key, rate limit, outage), before the customer sees a word.
# A provider counts as configured when its key (or local base URL) is set.
#
# Which model answers first (the smart, tool-using tier):
#   AI_SMART_PROVIDER=anthropic | google | groq | openai | local
#   AI_SMART_MODEL=...                 # optional; each provider has a default
#
# Who takes over, in this order unless AI_FALLBACK_CHAIN says otherwise:
#   local, groq, google, anthropic, openai   (open-weight first)
# Each takes over with its own tool-calling model, set by env if needed:
#   AI_GOOGLE_MODEL=gemini-3.6-flash   AI_ANTHROPIC_MODEL=claude-sonnet-5
#   AI_GROQ_MODEL=qwen/qwen3.8-27b     AI_OPENAI_MODEL=gpt-4o
#   AI_LOCAL_MODEL=qwen2.5
# AI_FALLBACK_CHAIN=groq,google,anthropic   # explicit order (unkeyed ones are skipped)
# AI_ALLOW_PROPRIETARY=false                 # keep the chain open-weight only
#
# A provider that fails on credit or a key is moved to the back for 10 minutes,
# so customers do not wait on it every message. Customers never see a
# provider's raw error; the server log has it.
#
# Examples:
#   Qwen on Groq first, Gemini and Claude behind it:
#     GROQ_API_KEY=gsk_...  AI_SMART_PROVIDER=groq
#     GOOGLE_GENERATIVE_AI_API_KEY=...  ANTHROPIC_API_KEY=sk-ant-...
#   A self-hosted model first:
#     AI_LOCAL_BASE_URL=http://host:11434/v1  AI_SMART_PROVIDER=local
#
# The fast tier (greetings, lookups) is separate: AI_FAST_MODEL (Google).
#
# Local / self-hosted model — ANY OpenAI-compatible endpoint (Ollama, vLLM,
# LM Studio, LocalAI, a private gateway). Set the base URL to enable it; it then
# becomes selectable as "local" and joins the fallback chain.
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# AI_LOCAL_MODEL=llama3.1
# AI_LOCAL_API_KEY=local
# AI_LOCAL_TIER=smart

# ─── Payments ───
# Active provider for NEW checkouts: "paystack", "yoco" or "payfast".
# Refunds and payment checks always go to the provider that took the payment.
# Creator payouts always use Paystack (Yoco has no payouts API).
PAYMENT_PROVIDER=paystack
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
NEXT_PUBLIC_PAYFAST_SANDBOX=true
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# Yoco: secret key from the Yoco app (Sales > Payment gateway), and the secret
# returned once when /api/webhooks/yoco is registered with Yoco.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# ─── Storage ───
# Active provider: "cloudinary", "supabase-storage", or "s3"
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── Email ───
# Active provider: "gmail" or "resend"
EMAIL_PROVIDER=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
# RESEND_API_KEY=

# ─── Search & RAG ───
SEARCH_PROVIDER=supabase
# Active provider: "gemini" (free, 768d) or "openai" (paid, 1536d)
EMBEDDING_PROVIDER=gemini
RAG_ENABLED=false

# ─── Cron ───
# Secret for authenticating Vercel cron job requests
CRON_SECRET=

# ─── Customer engagement: lifecycle emails + web push (migration 087) ───
# HMAC key for the one-click unsubscribe link in every lifecycle email
# (32+ characters; `openssl rand -base64 32`). Without it no lifecycle email is sent.
ENGAGEMENT_SIGNING_SECRET=
# true = the daily run only logs what it would send (no queueing, no sending)
ENGAGEMENT_DRY_RUN=false
# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services; defaults to mailto:STUDIO.email
VAPID_SUBJECT=

# ─── Phone checks (profile page "confirm your number") ───
# Which channel confirms phone numbers: "whatsapp" or "sms". Unset = WhatsApp
# when all its values below are set, else SMS when an SMS provider is set,
# else phone checks stay hidden and are not required. A chosen channel that is
# not fully configured means "off" (never a silent switch to the other one).
PHONE_VERIFY_CHANNEL=
# Secret the one-time codes are hashed with (32+ characters;
# `openssl rand -base64 32`). Falls back to SUPABASE_SERVICE_ROLE_KEY.
PHONE_CODE_SECRET=
# SMS: "smsgate", "bulksms" or "log" (lib/sms/index.ts for their variables).
SMS_PROVIDER=log

# ─── WhatsApp: Meta WhatsApp Business Cloud API ───
# Setup steps: docs/operations/whatsapp-setup.md. Free inbound phone checks:
# people send us a code, and the reply goes out inside the 24-hour window.
# Our own random string (`openssl rand -hex 24`), typed into Meta's webhook
# settings as the "Verify token". Meta echoes it when the callback URL is saved.
WHATSAPP_VERIFY_TOKEN=
# Meta app > App settings > Basic > App secret. Every webhook POST is signed with
# it (X-Hub-Signature-256); unsigned or wrongly signed posts are refused.
WHATSAPP_APP_SECRET=
# System User permanent token (whatsapp_business_messaging,
# whatsapp_business_management). Only needed to send the "confirmed" reply.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp > API setup > "Phone number ID" (an id, NOT the phone number).
WHATSAPP_PHONE_NUMBER_ID=
# The business WhatsApp number in E.164, e.g. +27600000000; used for the
# wa.me link people tap to send their code.
WHATSAPP_BUSINESS_NUMBER=
# Optional: "meta" or "twilio". Unset = "meta" once WHATSAPP_APP_SECRET is set.
# WHATSAPP_PROVIDER=meta
# Optional Graph API version for replies (default in lib/whatsapp/meta.ts).
# WHATSAPP_GRAPH_VERSION=v25.0
