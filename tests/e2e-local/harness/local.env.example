# LOCAL STACK ONLY. Copy to a file outside the repo (e.g. ~/tv-local.env),
# fill the two Supabase keys from `supabase status`, and `source` it before
# building, starting the app, the stub and the journeys. Never put real keys here.
export NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
export NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from supabase status>
export SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from supabase status>
export NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments: Paystack, answered by harness/stub.mjs (any sk_test_ value; the stub signs webhooks with it).
export PAYMENT_PROVIDER=paystack
export PAYSTACK_SECRET_KEY=sk_test_local_stub
export NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_local_stub

# AI: deliberately unreachable locally (journeys check graceful failure).
export AI_PROVIDER=anthropic
export ANTHROPIC_API_KEY=local-not-a-key

# Fake Cloudinary account: signing is local HMAC; uploads go to the stub.
export STORAGE_PROVIDER=cloudinary
export CLOUDINARY_CLOUD_NAME=journey-local
export CLOUDINARY_API_KEY=000000000000000
export CLOUDINARY_API_SECRET=local-only-not-a-secret

export EMAIL_PROVIDER=gmail
export SEARCH_PROVIDER=supabase
export RAG_ENABLED=false
# Phone codes are printed to the app log: "[sms:log] to +2782***: 123456 is your ...".
export SMS_PROVIDER=log
export ADDRESS_PROVIDER=nominatim

# Any local values (cron routes take "Authorization: Bearer $CRON_SECRET").
export CRON_SECRET=local-cron-secret
export AGENT_APPROVAL_SECRET=local-agent-approval-secret
export PHONE_CODE_SECRET=local-phone-code-secret
export CONSENT_IP_HASH_SECRET=local-consent-secret

# Where the app's server-side calls to Paystack/Nominatim/Cloudinary go (harness/preload.cjs).
export STUB_URL=http://localhost:4010
